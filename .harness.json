  "forked": {},
  "freshness": {
    "auditDays": 7,
    "backlogPRs": 10,
    "backlogDays": 1
  },
  "impact": [
    {
      "id": "contracts",
      "when": [
        "packages/contracts/**"
      ],
      "then": "The shared protocol and domain changed: hub, agent and client all compile against it. Bump PROTOCOL_VERSION for an incompatible MQTT change, and update docs/DESIGN.md.",
      "run": "npm run typecheck && npm test && npm run build",
      "checked": "Type check of all three parts, the hub+agent end-to-end test and the client build",
      "after": []
    },
    {
      "id": "backend",
      "when": [
        "apps/hub/**",
        "apps/agent/**",
        "tools/dev.ts"
      ],
      "then": "Run the backend suite (includes the hub+agent end-to-end test over real MQTT); reconcile docs/DESIGN.md and the README run and deploy sections.",
      "run": "npm test",
      "checked": "node --test suites in packages/, apps/hub/test and apps/agent/test",
      "after": [
        "contracts"
      ]
    },
    {
      "id": "client",
      "when": [
        "apps/client/**"
      ],
      "then": "Build and test the client; the hub serves apps/client/dist/client/browser, so a deployed hub needs a fresh build. Reconcile docs/STYLE-GUIDE.md for UI changes.",
      "run": "npm run build && npm run test:client",
      "checked": "Angular build and Vitest unit tests",
      "after": []
    },
    {
      "id": "mcp-tools",
      "when": [
        "apps/hub/src/mcp.ts",
        "apps/hub/src/commands.ts"
      ],
      "then": "The MCP tool surface NERV uses changed: update the tool table in docs/DESIGN.md (\"NERV\") and tell NERV's pack owner.",
      "run": "npm test",
      "checked": "MCP listing and call test in apps/hub/test/e2e.test.ts",
      "after": [
        "backend"
      ]
    },
    {
      "id": "work-items",
      "when": [
        "docs/work/**",
        "docs/agents/model-profiles.json",
        "tools/work-items.mjs",
        "tools/task-claims.mjs"
      ],
      "then": "Regenerate the source-owned ledger (npm run work:build), then the dependency and queue views; review task resources and owner pages.",
      "run": "npm run work:build && npm run check:work",
      "checked": "check:work, check:backlog, check:dependencies and check:queue in CI",
      "after": []
    }
  ],
  "couplings": [
    {
      "value": "Default grow calendar (phases, doses, EC/pH ranges)",
      "places": [
        {
          "file": "packages/contracts/src/dosing.ts",
          "what": "DEFAULT_CALENDAR"
        },
        {
          "file": "docs/DESIGN.md",
          "what": "Domain section: links DEFAULT_CALENDAR, quotes no numbers"
        }
      ],
      "kept": "By hand: the design doc links the code and quotes no numbers it cannot check; contracts.test.ts pins fresh-mix volumes."
    },
    {
      "value": "MQTT topics and message shapes",
      "places": [
        {
          "file": "packages/contracts/src/mqtt.ts",
          "what": "topics, schemas, PROTOCOL_VERSION"
        },
        {
          "file": "docs/DESIGN.md",
          "what": "Protocol section"
        }
      ],
      "kept": "Both sides import the same module; the hub+agent end-to-end test covers every topic."
    }
  ],
  "outside": [
    {
      "what": "Raspberry Pi OS (pinctrl, w1-therm, i2c), wiring and probe calibration",
      "affects": "Hardware drivers in apps/agent/src/drivers/hardware.ts",
      "noticed": "Only on the device: no CI covers it (backlog record for the hardware bring-up)"
    },
    {
      "what": "Tailscale (MagicDNS, tailscale serve) and NERV's MCP client",
      "affects": "Remote access to the hub and NERV control",
      "noticed": "Manual check after deploy"
    }
  ],
  "pages": [
    {
      "title": "Design",
      "path": "docs/DESIGN.md",
      "about": "Architecture, protocol, dosing, safety, NERV integration"
    },
    {
      "title": "Code coverage",
      "path": "docs/agents/coverage.md",
      "about": "Backend coverage per folder, from npm run coverage"
    }
  ],
