  "audit": {
    "days": 7,
    "enforce": false
  },
  "rules": {
    "agents": "AGENTS.md",
    "procedures": [
      "docs/BACKLOG-RULES.md",
      "docs/agents/*.md",
      "docs/backlog/*.md"
    ],
    "maxLines": 200,
    "budgets": {
      "always": 3500,
      "procedure": 2000,
      "trigger": 5000
    }
  },
  "behaviour": {
    "times": 3,
    "runner": "claude -p --permission-mode acceptEdits --allowedTools \"Bash(git:*)\" \"Bash(npm:*)\" \"Bash(node:*)\" -- \"$(cat \"$HARNESS_TASK_FILE\")\""
  },
  "verification": {
    "enabled": false
  },
  "workItems": {
    "enabled": true,
    "layout": "docs/work/layout.json",
    "records": "docs/work/records",
    "tasks": "docs/work/tasks",
    "profiles": "docs/agents/model-profiles.json",
    "featurePlans": true,
    "order": "queue",
    "estimation": {
      "since": "2026-11-24"
    },
    "repository": "voidbrain/Grover"
  },
  "workUsage": {
    "enabled": true,
    "pauseGapMinutes": 15
  },
  "conventions": {
    "pureDirs": [],
