{
  "name": "grover",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Grover: local-first hydroponic grow controller. Hub, agents and an Angular client over Tailscale and MQTT.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "hub": "node --env-file-if-exists=.env apps/hub/src/main.ts",
    "agent": "node --env-file-if-exists=.env apps/agent/src/main.ts",
    "dev": "node tools/dev.ts",
    "client": "npm --workspace apps/client start",
    "build": "npm --workspace apps/client run build",
    "test": "node --test --test-reporter=./tools/quiet-reporter.mjs --test-reporter-destination=stdout --test-reporter=spec --test-reporter-destination=.test-report.txt 'packages/*/test/*.test.ts' 'apps/hub/test/*.test.ts' 'apps/agent/test/*.test.ts'",
    "test:client": "npm --workspace apps/client test -- --watch=false",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/client/tsconfig.app.json --noEmit",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='packages/*/src/**' --test-coverage-include='apps/hub/src/**' --test-coverage-include='apps/agent/src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'packages/*/test/*.test.ts' 'apps/hub/test/*.test.ts' 'apps/agent/test/*.test.ts' && node tools/lcov-summary.mjs",
    "coverage": "npm run test:coverage && node tools/coverage-table.mjs --write",
    "check:backlog": "node tools/check-backlog.mjs",
    "check:freshness": "node tools/check-freshness.mjs",
    "impact-map": "node tools/impact-map.mjs",
    "ci:status": "node tools/ci-status.mjs",
    "code:map": "node tools/code-map.mjs",
    "reconcile:draft": "node tools/reconcile-draft.mjs",
    "check:conventions": "node tools/check-conventions.mjs",
    "check:integrations": "node tools/mcp.mjs check",
    "mcp:recommend": "node tools/mcp.mjs recommend",
    "reconcile:preview": "node tools/reconcile-preview.mjs",
    "friction": "node tools/friction.mjs",
    "check:maintenance": "node tools/maintenance.mjs check",
    "check:audits": "node tools/check-audits.mjs",
    "archive:recap": "node tools/archive-recap.mjs",
    "check:archive-recap": "node tools/archive-recap.mjs --check",
    "guard:install": "node tools/guard.mjs install",
    "check:rules": "node tools/check-rules.mjs",
    "check:tooling": "node tools/check-tooling.mjs",
    "behaviour": "node tools/behaviour.mjs",
    "coverage:browser": "node tools/browser-coverage.mjs",
    "check:dependencies": "node tools/backlog-dependencies.mjs --check",
    "check:queue": "node tools/backlog-queue.mjs --check",
    "verification:plan": "node tools/verification.mjs",
    "work:build": "node tools/work-items.mjs build",
    "work:close": "node tools/work-items.mjs close",
    "check:work": "node tools/work-items.mjs check",
    "work:tasks": "node tools/work-items.mjs tasks",
    "work:next": "node tools/work-items.mjs next",
    "work:claims": "node tools/task-claims.mjs",
    "work:usage": "node tools/work-usage.mjs",
    "work:launch": "node tools/usage-launch.mjs",
    "rule-load": "node tools/rule-load.mjs",
    "check:rule-load": "node tools/rule-load.mjs --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:fast": "npm run format:check && npm run lint && npm run typecheck && npm run check:backlog && npm run check:work && npm run check:rules"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.74.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.9": true,
    "msgpackr-extract@3.0.7": true
  }
}
